// ============================================================
// Proximo — Schéma Prisma (PostgreSQL 16 + PostGIS)
//
// Note géographique : lat/lng sont stockés en Float simples ;
// l'index spatial GiST est créé par la migration sur une
// expression PostGIS (voir prisma/migrations/.../migration.sql).
// Les requêtes de périmètre utilisent $queryRaw + ST_DWithin.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Résidence (une instance héberge N résidences) ───────────
// Chaque résidence a son code d'accès (prérequis inscription),
// son agence/syndic (email destinataire des signalements) et son nom.
model Residence {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique // requis pour créer un compte (vide = inscription libre)
  agencyName  String?
  syndicEmail String? // email de l'agence / du syndic (alertes signalements)
  // Notifications par email (gérées par l'admin de la résidence) :
  // signalement → email à l'agence ; signalement / annonce → email aux habitants
  notifyAgencyOnIncident    Boolean @default(true)
  notifyResidentsOnIncident Boolean @default(true)
  notifyResidentsOnListing  Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  listings    Listing[]
  incidents   Incident[]
  invitations Invitation[]
}

// ─── Utilisateur ──────────────────────────────────────────────
model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String? // null pour les comptes créés via Google OAuth
  googleId           String?   @unique
  firstName          String
  lastName           String
  neighborhood       String?
  building           String? // bâtiment (optionnel, ex. « B »)
  floor              String? // étage (optionnel, ex. « 3e »)
  showDetails        Boolean   @default(true) // afficher bâtiment/étage sur les annonces
  showInDirectory    Boolean   @default(true) // apparaître dans l'annuaire des voisins (RGPD : choix)
  role               String    @default("USER") // USER | ADMIN | SUPERADMIN
  status             String    @default("PENDING") // PENDING | ACTIVE | SUSPENDED
  totpSecret         String? // secret TOTP chiffré côté application (2FA admin)
  totpEnabled        Boolean   @default(false)
  emailNotifications Boolean   @default(true)
  lastSeenAt         DateTime? // dernière connexion (annuaire « voisins récents »)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  residenceId String?
  residence   Residence? @relation(fields: [residenceId], references: [id], onDelete: SetNull)

  listings      Listing[]
  conversationsA Conversation[] @relation("convA")
  conversationsB Conversation[] @relation("convB")
  sentMessages  Message[]      @relation("msgSender")
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  incidents     Incident[]
  invitations   Invitation[]
  comments      Comment[]

  @@index([residenceId])
}

// ─── Annonce d'entraide ───────────────────────────────────────
model Listing {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String // TOOL | SERVICE | DONATION | OTHER
  status      String  @default("OPEN") // OPEN | RESERVED | CLOSED
  lat         Float // coordonnées approximatives — JAMAIS exposées par l'API
  lng         Float
  address     String // adresse saisie — masquée dans les réponses API
  neighborhood String // quartier/ville affiché (ex. "Lyon 7e")
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  comments    Comment[]
  residenceId String?
  residence   Residence? @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([category, status])
  @@index([residenceId])
}

// ─── Token de rafraîchissement (révocable) ────────────────────
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String // SHA-256 du token (jamais stocké en clair)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Réinitialisation de mot de passe (lien à usage unique) ──
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 du jeton (jamais stocké en clair)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Conversation (messagerie 1-1) ────────────────────────────
model Conversation {
  id        String    @id @default(uuid())
  userAId   String // ordre lexicographique : plus petit des deux ids
  userBId   String
  userA     User      @relation("convA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("convB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userAId, userBId])
  @@index([userBId])
}

// ─── Message ──────────────────────────────────────────────────
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("msgSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ─── Signalement d'incident (syndic) ──────────────────────────
model Incident {
  id          String   @id @default(uuid())
  title       String
  category    String // WATER_LEAK | ELEVATOR | DAMAGE | OTHER
  description String
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments IncidentAttachment[]
  comments    Comment[]
  residenceId String?
  residence   Residence? @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([residenceId])
}

// ─── Pièce jointe d'un signalement ────────────────────────────
model IncidentAttachment {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  path       String // chemin relatif dans le volume /data/uploads
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

// ─── Réglages syndic / agence (singleton id=1) ────────────────
model SyndicSettings {
  id            Int      @id @default(1) // singleton
  agencyName    String
  email         String
  residenceName String? // nom de la résidence affiché dans toute l'interface et les mails
  residenceCode String? // code requis pour créer un compte (vide = inscription libre)
  updatedAt     DateTime @updatedAt
}

// ─── Réglages d'envoi d'emails (singleton id=1) ───────────────
// Configurés depuis l'admin (onglet Réglages, superadmin) — priorité sur les
// variables d'environnement. `mode` : 'brevo' | 'smtp' | 'log'.
// Les notifications par email aux habitants / à l'agence sont, elles,
// configurables PAR RÉSIDENCE (colonnes notify* de Residence).
model EmailSettings {
  id            Int      @id @default(1) // singleton
  mode          String   @default("brevo")
  fromName      String   @default("Proximo")
  fromEmail     String   @default("no-reply@proximo.local")
  // Brevo
  brevoApiKey   String?
  // SMTP générique
  smtpHost      String?
  smtpPort      Int?     @default(587)
  smtpSecure    Boolean  @default(false)
  smtpUser      String?
  smtpPass      String?
  updatedAt     DateTime @updatedAt
}

// ─── File d'attente d'emails (quota Brevo dépassé) ───────────
// Un email dont l'envoi échoue pour cause de quota (Brevo gratuit :
// 300 emails/jour) est conservé ici et renvoyé automatiquement à la
// prochaine réinitialisation du compteur. `attachments` : JSON
// [{ "filename": ..., "path": ... }] — chemins relatifs au volume uploads.
model EmailOutbox {
  id          String   @id @default(uuid())
  to          String
  subject     String
  html        String   @db.Text
  attachments String?  @db.Text
  attempts    Int      @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([sentAt, createdAt])
}

// ─── Invitation (QR code / lien à usage unique) ───────────────
model Invitation {
  id           String    @id @default(uuid())
  token        String    @unique
  neighborhood String // quartier / résidence ciblé par l'invitation
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  residenceId  String?
  residence    Residence? @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  usedAt       DateTime?
  multiUse     Boolean   @default(false) // affiche QR : usage illimité jusqu'à expiration
  createdAt    DateTime  @default(now())

  @@index([createdById])
  @@index([residenceId])
}

// ─── Demande de souscription (tunnel de vente) ────────────────
// Lead commercial capté depuis la page publique /souscrire.
// `unitCount` : LESS_THAN_10 | BETWEEN_10_30 | BETWEEN_30_100 | MORE_THAN_100
// `requesterRole` : HABITANT | CONSEIL_SYNDICAL | SYNDIC | GESTIONNAIRE
// `status` : NEW | PENDING_PAYMENT | PAID | CONTACTED | WON | LOST
model Lead {
  id              String    @id @default(uuid())
  name            String
  email           String
  residenceName   String
  city            String
  unitCount       String
  requesterRole   String
  message         String?
  stripeSessionId String?   @unique
  status          String    @default("NEW")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provision Provision?

  @@index([status])
}

// ─── Provisionnement d'une instance (après paiement Stripe) ──
// Une résidence payante reçoit sa propre instance Proximo (base isolée).
// `status` : PENDING | PROVISIONING | ACTIVE | FAILED
// `slug` : sous-domaine de l'instance (ex. <slug>.147.ovh)
model Provision {
  id        String   @id @default(uuid())
  leadId    String   @unique
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  slug      String   @unique
  status    String   @default("PENDING")
  domain    String?
  adminEmail String
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─── Commentaire public (annonce ou signalement) ─────────────
// Discussion dédiée à chaque annonce / signalement, visible par tous
// les habitants de la résidence. Polymorphe : un seul des deux champs
// (listingId / incidentId) est renseigné.
model Comment {
  id          String    @id @default(uuid())
  content     String
  listingId   String?
  listing     Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  incidentId  String?
  incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([listingId, createdAt])
  @@index([incidentId, createdAt])
  @@index([authorId])
}
